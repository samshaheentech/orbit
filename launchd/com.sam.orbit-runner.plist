<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sam.orbit-runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ORBIT__/run.sh</string>
  </array>

  <!-- Polls every 15 minutes. run.sh asks system/window.py whether it is inside one of Orbit's windows
       (config/schedule.json, default 22:00 and 03:00, five hours each) with budget and time left; otherwise it exits
       in under a second and logs nothing. -->
  <key>StartInterval</key><integer>900</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>MAX_TASKS_PER_RUN</key><string>2</string>
    <key>TASK_TIMEOUT_SEC</key><string>5400</string>
    <key>DEFAULT_MODEL</key><string>claude-sonnet-5</string>
    <key>DEFAULT_EFFORT</key><string>medium</string>
    <key>DEFAULT_MAX_TURNS</key><string>60</string>
  </dict>

  <key>StandardOutPath</key><string>__ORBIT__/logs/runner.out</string>
  <key>StandardErrorPath</key><string>__ORBIT__/logs/runner.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
